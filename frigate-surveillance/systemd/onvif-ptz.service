[Unit]
Description=ONVIF PTZ bridge (Frigate to Pepper head via ALMotion)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nao
Group=nao
Environment=PYTHONPATH=/opt/aldebaran/lib/python2.7/site-packages
# Fallback advertise host only — the bridge normally echoes the Host header the
# client used, so PTZ survives DHCP IP changes. Use a stable DNS name here.
Environment=ONVIF_HOST=pepper
WorkingDirectory=/data/onvif
ExecStart=/usr/bin/python2 /data/onvif/onvif_ptz.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
