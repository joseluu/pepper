# Service UTILISATEUR de nao (~/.config/systemd/user/), comme ceux du fantome
# (voir halloween/STATUT_HALLOWEEN.md, Demarrage automatique : /etc/systemd est
# lu trop tard au demarrage). Exclusif avec les services halloween (meme port
# 8090 pour le pont audio, 8080 pour la page). Installation : compagnie3po/README.md.
[Unit]
Description=Pont audio de 3PO (micro USB + haut-parleur pour live3po.py sur tram, port 8090)
Conflicts=halloween-dialogue.service

[Service]
Type=simple
WorkingDirectory=/home/nao/dialogue
Environment=PYTHONPATH=/opt/aldebaran/lib/python2.7/site-packages
ExecStartPre=/usr/bin/python2 /home/nao/halloween/wait_naoqi.py
ExecStart=/bin/sh -c 'exec /usr/bin/python2 -u robot_audio.py --prefix 3PO >> bridge3po.log 2>&1'
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
WantedBy=default.target
